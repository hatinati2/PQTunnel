# Example only. Copy to /etc/pqtunnel/site-to-site.env and edit on an isolated lab host.
# This file is shell syntax; keep it root-owned and non-writable by group/others.
# No settings are applied by merely creating/editing this example.

# On the Iran host (the side that initiates the tunnel):
PQTUNNEL_ROLE=dialer
PQTUNNEL_WAN_IF=eth0
PQTUNNEL_TUN=pqtun0

# Mark only local OUTPUT traffic whose destination port matches these lists.
PQTUNNEL_TCP_EGRESS_PORTS=443
PQTUNNEL_UDP_EGRESS_PORTS=53,123

# Optional inbound port forwards on Iran: localPort=targetIP:targetPort.
# The target IP must be a literal address reachable through the tunnel/gateway.
# IPv6 target form: 8443=[2001:db8::50]:443
# Example: accept Iran tcp/8443 and forward it to destination tcp/443.
PQTUNNEL_TCP_FORWARD_RULES=8443=203.0.113.50:443
PQTUNNEL_UDP_FORWARD_RULES=

# Configure this allowlist on BOTH pqtunnel-client and pqtunneld in Germany.
# It must contain the remote target ports above plus all selected egress ports.
# For the example above: tcp:443,udp:53,udp:123
# PQTUNNEL_ALLOWED_DST_PORTS=tcp:443,udp:53,udp:123

# On Germany, use a separate config file with at least:
# PQTUNNEL_ROLE=gateway
# PQTUNNEL_WAN_IF=eth0
# PQTUNNEL_TUN=pqtun0
# Leave all *_EGRESS_PORTS and *_FORWARD_RULES blank on the gateway config.
