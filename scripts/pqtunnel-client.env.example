# Dialer/client environment for a single site-to-site peer.
# Copy/adjust this file locally, then provide it with --client-env-file.
# Use a DNS name present in the listener certificate SAN for PQTUNNEL_SERVER_NAME.
PQTUNNEL_SERVER=vpn.example.com:8443
PQTUNNEL_SERVER_NAME=vpn.example.com
# Include the dialer's tunnel/local CIDR(s) and the actual Iran-side LAN CIDR(s).
PQTUNNEL_LOCAL_PREFIXES=10.66.0.2/32,192.0.2.0/24
# Include only the intended Germany-side site prefixes, or a default only after routing review.
PQTUNNEL_REMOTE_PREFIXES=198.51.100.0/24,2001:db8:1::/48
# Keep consistent with the gateway allowlist and selective network egress/forward rules.
PQTUNNEL_ALLOWED_DST_PORTS=tcp:443,udp:53,udp:123
