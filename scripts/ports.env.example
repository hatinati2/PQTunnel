# EXAMPLE ONLY. Copy to /etc/pqtunnel/ports.env and edit for a dedicated TEST host.
# Do not source a writable/untrusted file as root. The helper requires root-owned config.

PQTUNNEL_TUN_IF="pqtun0"
PQTUNNEL_TUN_IPV4="10.66.0.2"
# Leave empty to fail closed for IPv6 traffic using the selected TCP/UDP ports.
PQTUNNEL_TUN_IPV6="fd66::2"
PQTUNNEL_WAN_IF="eth0"

# Underlay endpoint (Germany listener): bare DNS name or literal IP, no brackets.
PQTUNNEL_ENDPOINT="vpn.example.net"
PQTUNNEL_ENDPOINT_PORT="8443"

# Local processes on Iran: only these destination ports get policy-routed into TUN.
PQTUNNEL_EGRESS_TCP_PORTS="443,8443"
PQTUNNEL_EGRESS_UDP_PORTS="53"

# Incoming connections to Iran are DNATed over TUN to a literal Germany-side address.
# syntax: LOCAL_PORT=TARGET_IP:TARGET_PORT,LOCAL_PORT=[TARGET_IPV6]:TARGET_PORT
# Use a service IP assigned on Germany or a LAN IP routed behind Germany.
PQTUNNEL_FORWARD_TCP="8443=203.0.113.10:443,2222=203.0.113.10:22"
PQTUNNEL_FORWARD_UDP="5353=203.0.113.10:53"

# Configure the exact same allowlist on pqtunnel-client (Iran) and pqtunneld (Germany).
# This list must contain REMOTE destination ports, not the public ingress ports on Iran.
PQTUNNEL_PORT_POLICY="tcp:443,22;udp:53"
