# Gateway/listener environment for a single site-to-site peer.
# Copy/adjust this file locally, then provide it with --server-env-file.
# This is systemd EnvironmentFile syntax: plain KEY=VALUE entries only.
PQTUNNEL_LISTEN=0.0.0.0:8443,[::]:8443
PQTUNNEL_TLS_CERT=/etc/pqtunnel/pki/server.crt
PQTUNNEL_TLS_KEY=/etc/pqtunnel/pki/server.key
PQTUNNEL_CLIENT_CA=/etc/pqtunnel/pki/ca.crt
PQTUNNEL_MAX_CLIENTS=1
# Replace these documentation/example CIDRs with your actual non-overlapping site prefixes.
PQTUNNEL_PEER_PREFIXES=10.66.0.2/32,192.0.2.0/24
PQTUNNEL_LOCAL_PREFIXES=198.51.100.0/24,2001:db8:1::/48
# Must exactly match the peer certificate Common Name.
PQTUNNEL_PEER_NAME=iran
# Must include every selected egress destination port and every forwarded target port.
PQTUNNEL_ALLOWED_DST_PORTS=tcp:443,udp:53,udp:123,tcp:8443
