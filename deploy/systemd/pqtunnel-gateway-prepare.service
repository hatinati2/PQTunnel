[Unit]
Description=PQTunnel guarded Gateway network preflight
After=network-online.target
Wants=network-online.target
Documentation=https://github.com/hatinati2/PQTunnel/docs/WEB-ADMIN-PANEL.md

[Service]
Type=oneshot
ExecStart=/usr/local/lib/pqtunnel/site-to-site-selective.sh gateway-prepare
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pqtunnel-manager
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
