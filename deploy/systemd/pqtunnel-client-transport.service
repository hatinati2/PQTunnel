[Unit]
Description=PQTunnel Dialer transport (no host routing/firewall changes)
Wants=network-online.target
After=network-online.target
Documentation=https://github.com/hatinati2/PQTunnel

[Service]
Type=simple
EnvironmentFile=/etc/default/pqtunnel-client
ExecStartPre=/usr/local/lib/pqtunnel/pqtunnel-transport-tun.sh dialer up
ExecStart=/usr/local/lib/pqtunnel/run-client.sh
ExecStopPost=/usr/local/lib/pqtunnel/pqtunnel-transport-tun.sh dialer down
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077
RuntimeDirectory=pqtunnel
RuntimeDirectoryMode=0750
StateDirectory=pqtunnel
StateDirectoryMode=0750
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
