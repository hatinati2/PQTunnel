[Unit]
Description=PQTunnel hybrid post-quantum tunnel server (experimental)
Wants=network-online.target
After=network-online.target
Documentation=https://github.com/hatinati2/PQTunnel

[Service]
Type=simple
EnvironmentFile=-/etc/default/pqtunneld
ExecStartPre=/bin/sh -ec 'ip link show pqtun0 >/dev/null 2>&1 || ip tuntap add dev pqtun0 mode tun; ip address replace 10.66.0.1/24 dev pqtun0; ip link set dev pqtun0 up'
ExecStart=/usr/local/sbin/pqtunneld --listen ${PQTUNNEL_LISTEN} --tls-cert /etc/pqtunnel/pki/server.crt --tls-key /etc/pqtunnel/pki/server.key --client-ca /etc/pqtunnel/pki/ca.crt --tun pqtun0 --max-clients ${PQTUNNEL_MAX_CLIENTS}
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
