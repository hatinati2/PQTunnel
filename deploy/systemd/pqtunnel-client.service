[Unit]
Description=PQTunnel experimental site-to-site dialer
Wants=network-online.target
After=network-online.target
Documentation=https://github.com/hatinati2/PQTunnel

[Service]
Type=simple
EnvironmentFile=/etc/default/pqtunnel-client
Environment=PQTUNNEL_SITE_CONFIG=/etc/pqtunnel/site-to-site.env
ExecStartPre=/usr/local/lib/pqtunnel/site-to-site-selective.sh dialer-up
ExecStart=/usr/local/bin/pqtunnel-client --server $PQTUNNEL_SERVER --server-name $PQTUNNEL_SERVER_NAME --ca /etc/pqtunnel/pki/ca.crt --cert /etc/pqtunnel/pki/client.crt --key /etc/pqtunnel/pki/client.key --local-prefixes $PQTUNNEL_LOCAL_PREFIXES --remote-prefixes $PQTUNNEL_REMOTE_PREFIXES --allowed-dst-ports $PQTUNNEL_ALLOWED_DST_PORTS --socket-mark 20560
ExecStopPost=/usr/local/lib/pqtunnel/site-to-site-selective.sh dialer-down
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077
StateDirectory=pqtunnel
StateDirectoryMode=0750
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
