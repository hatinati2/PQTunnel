[Unit]
Description=PQTunnel Gateway selective network policy
After=pqtunneld.service
Documentation=https://github.com/hatinati2/PQTunnel/docs/WEB-ADMIN-PANEL.md

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/lib/pqtunnel/site-to-site-selective.sh gateway-up
ExecStop=/usr/local/lib/pqtunnel/site-to-site-selective.sh gateway-cleanup
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
StateDirectory=pqtunnel
StateDirectoryMode=0750
ReadWritePaths=/var/lib/pqtunnel-manager
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
CapabilityBoundingSet=CAP_NET_ADMIN
AmbientCapabilities=CAP_NET_ADMIN
