# Copy into /etc/pqtunnel/client.env on the LINUX CLIENT, then edit values.
# Use the server's literal IPv4 address to avoid resolving its name outside the tunnel.
PQTUNNEL_SERVER_IP=203.0.113.10
PQTUNNEL_SERVER_PORT=8443
PQTUNNEL_SERVER_NAME=vpn.example.com
PQTUNNEL_LOCAL_IP=10.66.0.2
PQTUNNEL_TUN=pqtun0
PQTUNNEL_DNS=1.1.1.1
PQTUNNEL_CA_FILE=/etc/pqtunnel/pki/ca.crt
PQTUNNEL_CLIENT_CERT=/etc/pqtunnel/pki/client.crt
PQTUNNEL_CLIENT_KEY=/etc/pqtunnel/pki/client.key
